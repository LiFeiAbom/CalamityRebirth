Configs: {
	VanillaNerfRevertConfig: {
		DisplayName: 原版削弱回调
		Headers.Gameplay: 玩法

		RevertVanillaNerfs: {
			Label: 还原灾厄对原版的削弱
			Tooltip:
				'''
				适用于现代 CalamityMod 2.2.2、CalamityModClassicPreTrailer 1.4.2.101 与 CalRD 1.4.5.7。
				还原各版本实际削弱的原版武器、工具、护甲、饰品、翅膀、增益、移动速度与召唤弹幕伤害。
				不会修改灾厄自身内容的削弱。
				开启或关闭后需要重载模组。
				默认：关闭。
				'''
		}
	}
}

