		Tooltip: Fires a projectile that changes color based on your current biome
	}

	TrueBiomeBlade: {
		DisplayName: True Biome Blade
		Tooltip: Fires enhanced biome orbs that home in on nearby enemies
	}

	OmegaBiomeBlade: {
		DisplayName: Omega Biome Blade
		Tooltip:
			'''
			Scatters five short-range homing biome orbs
			Lunar pillar biomes and moon events alter their effects
			'''
	}

	FourSeasonsGalaxia: {
		DisplayName: Four Seasons Galaxia
		Tooltip:
			'''
			Fires a highly homing Galaxia orb
			Projectiles inflict different debuffs based on your biome
			Hits grant buffs based on your biome and moon events
			'''
	}

	ArkoftheAncients: {
		DisplayName: Ark of the Ancients
		Tooltip: Alternates between Eon Beams and Enchanted Beams while calling down hallowed stars
	}

	TrueArkoftheAncients: {
		DisplayName: True Ark of the Ancients
		Tooltip: Calls down empowered Eon Beams, hallowed stars, and homing terra balls
	}

	ArkoftheElements: {
		DisplayName: Ark of the Elements
		Tooltip: Fires an Eon Beam and four homing elemental orbs that inflict multiple elemental debuffs
	}

	ArkoftheCosmos: {
		DisplayName: Ark of the Cosmos
		Tooltip:
			'''
			Fires an Eon Beam alongside four full-damage Galaxia orbs
			Projectiles inflict different debuffs based on your biome
			Hits grant buffs based on your biome and moon events
			'''
	}

	Ataraxia: {
		DisplayName: Ataraxia
		Tooltip:
			'''
			Fires a main missile and two side missiles when swung
			The main missile creates a small explosion on hit
			Side missiles split into six needle projectiles on hit
			Melee strikes trigger a large explosion and a petal pattern
			Hits inflict Shadowflame
			'''
	}

	DarkSunRing: {
		DisplayName: Dark Sun Ring
		Tooltip:
			'''
			12% increased damage, minion knockback, and melee attack speed
			5% increased critical strike chance
			+0.5 HP/s life regeneration, 15% increased mining speed, and +2 max minions
			During the day, grants an additional +1.5 HP/s life regeneration
			During the night, grants +30 defense
			Both bonuses are granted during an eclipse
			"Contains the power of the dark sun"
			'''
	}

	RottenBrain: {
		DisplayName: Rotten Brain
		Tooltip:
			'''
			15% increased damage when below 75% life
			5% decreased movement speed when below 50% life
			Shade rains down while invincible after being hit
			'''
	}

	AmalgamatedBrain: {
		DisplayName: Amalgamated Brain
		Tooltip:
			'''
			10% increased all damage and 5% critical strike chance
			Shade rains down while invincible after being hit
			Confuses nearby enemies when you are struck
			10% chance to completely dodge attacks
			'''
	}

	CalamityRing: {
		DisplayName: Calamity Ring
		Tooltip:
			'''
			Cursed?
			15% increased damage
			Brimstone fire rains down while invincibility is active
			'''
	}

	Gehenna: {
		DisplayName: Gehenna
		Tooltip: Drops brimstone fireballs from the sky periodically
	}

	VoidofExtinction: {
		DisplayName: Void of Extinction
		Tooltip:
			'''
			No longer cursed
			Drops brimstone fireballs from the sky periodically
			15% increased damage
			Brimstone fire rains down while invincibility is active
			Temporary immunity to lava and 25% increased damage while in lava
			'''
	}

	FungalClump: {
		DisplayName: Fungal Clump
		Tooltip:
			'''
			Summons a fungal clump to fight for you
			The clump latches onto enemies and steals their life for you
			'''
	}

	LeviathanAmbergris: {
		DisplayName: Leviathan Ambergris
		Tooltip:
			'''
			Leaves poisonous seawater behind while moving
			75% increased movement speed, 10% increased damage, and +20 defense while submerged
			Grants a damaging aura after being hit while submerged
			+5% damage and damage reduction while outside liquids
			'''
	}

	TheAmalgam: {
		DisplayName: The Amalgam
		Tooltip:
			'''
			20% increased all damage and 10% increased critical strike chance
			Shade and brimstone fire rain down while invincibility is active
			Confuses nearby enemies when you are struck
			Drops brimstone fireballs from the sky periodically
			25% increased damage while in lava and temporary immunity to lava
			Summons a powerful fungal clump to fight for you
			75% increased movement speed, 10% increased damage, and +40 defense while submerged
			Has a 1/8 chance to completely dodge attacks
			'''
	}

	CoreOfTheBloodGod: {
		DisplayName: Core of the Blood God
		Tooltip:
			'''
			10% increased maximum life
			10% increased damage reduction
			12% increased all damage and critical strike chance
			12% increased melee attack speed
			15% increased damage while defense is below 100
			Halves enemy contact damage
			This effect has a 20 second cooldown after taking contact damage
			You are surrounded by a damaging life-draining aura
			'''
	}

	BloodflareCore: {
		DisplayName: Bloodflare Core
		Tooltip:
			'''
			You are surrounded by a damaging life-draining aura
			Below 50% life: 15% increased damage reduction and 10% increased all damage and critical strike chance
			Below 15% life: 20% increased damage reduction and 20% increased all damage and critical strike chance
			15% increased damage while defense is below 100
			'''
	}

	BloodPact: {
		DisplayName: Blood Pact
		Tooltip:
			'''
			Doubles your maximum life
			You have a 25% chance to be critically hit
			'''
	}

	FleshTotem: {
		DisplayName: Flesh Totem
		Tooltip:
			'''
			Halves enemy contact damage
			This effect has a 20 second cooldown after taking contact damage
			'''
	}

	BloodyWormScarf: {
		DisplayName: Bloody Worm Scarf
		Tooltip:
			'''
			10% increased melee damage
			10% increased melee attack speed
			10% increased damage reduction
			'''
	}

	BloodyWormTooth: {
		DisplayName: Bloody Worm Tooth
		Tooltip:
			'''
			5% increased melee damage, melee attack speed, and damage reduction
			10% increased melee damage, melee attack speed, and damage reduction below 50% life
			'''
	}

	CrownJewel: {
		DisplayName: Crown Jewel
		Tooltip:
			'''
			Increases life regeneration by 1 HP/s
			While afflicted by any listed combat debuff, regeneration rises to 2.5 HP/s and accumulates much faster
			'''
	}

	InfectedJewel: {
		DisplayName: Infected Jewel
		Tooltip:
			'''
			Increases life regeneration by 1 HP/s
			While afflicted by any listed combat debuff, regeneration rises to 3 HP/s and accumulates much faster
			Grants 5 extra defense per additional debuff, starting at 16 for the first, and loses 1 per second after debuffs fall off
			'''
	}

	HoneyDew2: {
		DisplayName: Honey Dew (Ancient)
		Tooltip:
			'''
			Increases maximum life by 30
			Grants honey-style life regeneration at all times
			Regenerates faster while standing still in honey
			Toxic and sickness debuffs expire twice as fast
			'''
	}

	LivingDew2: {
		DisplayName: Living Dew (Ancient)
		Tooltip:
			'''
			Increases maximum life by 50
			Inherits all effects of Honey Dew (Ancient)
			Debuff durations are also halved for fire debuffs
			'''
	}

	RadiantOoze2: {
		DisplayName: Radiant Ooze (Ancient)
		Tooltip:
			'''
			Grants more life regeneration the lower your life is, from 2 HP/s at full to 6 HP/s when empty
			Emits a warm yellow light
			'''
	}

	AmbrosialAmpoule2: {
		DisplayName: Ambrosial Ampoule (Ancient)
		Tooltip:
			'''
			Increases maximum life by 70
			Inherits all effects of Living Dew (Ancient)
			Grants more life regeneration the lower your life is, from 2 HP/s at full to 6 HP/s when empty
			Regenerates faster while standing still, and emits a warm yellow light
			'''
	}

	Purity: {
		DisplayName: Purity
		Tooltip:
			'''
			Increases maximum life by 100
			Grants immunity to knockback
			Inherits the ancient Ambrosial Ampoule's honey regeneration and debuff-duration reduction
			Grants more life regeneration the lower your life is, from 3 HP/s at full to 7 HP/s when empty
			Grants 8 extra defense per additional debuff, starting at 20 for the first, and loses 1 per second after debuffs fall off
			Heals while debuffed, but the healing interval lengthens the longer the debuffs persist
			Greatly reduces damage from persistent combat debuffs
			'''
	}

	FrigidBulwark: {
		DisplayName: Frigid Bulwark
		Tooltip:
			'''
			Absorbs 25% of damage done to players on your team
			Only active above 25% life
			Grants immunity to knockback
			Puts a damage-reducing shell around the owner below 50% life
			Damage reduction is increased by a further 5% below 15% life
			'''
	}

	DeificAmulet: {
		DisplayName: Deific Amulet
		Tooltip:
			'''
			Taking damage makes you move very fast for a short time
			Increases armor penetration by 25 and immune time after being struck
			Provides light underwater and causes three holy stars to fall when damaged
			Increases pickup range for mana stars and restores mana when damaged
			'''
	}

	RampartofDeities: {
		DisplayName: Rampart of Deities
		Tooltip:
			'''
			Taking damage makes you move very fast for a short time
			Increases armor penetration by 50 and immune time after being struck
			Provides light underwater and causes six holy stars to fall when damaged
			Increases pickup range for mana stars and restores mana when damaged
			Absorbs 25% of damage done to players on your team
			Only active above 25% life
			Grants immunity to knockback
			Puts a damage-reducing shell around the owner below 50% life
			Damage reduction is increased by a further 5% below 15% life
			'''
	}

	AsgardianAegis: {
		DisplayName: Asgardian Aegis
		Tooltip:
			'''
			Allows a ram dash empowered by cosmic inferno
			The dash can slam through enemies without taking damage
			Increases maximum life by 40 and life regeneration by 2.5 HP/s
			Grants immunity to knockback, lava and fire
			Grants immunity to the vast majority of debuffs, including God Slayer Inferno
			Grants 12% damage reduction while submerged in liquid
			Grants 10 defense while below 25% life
			'''
	}

	AsgardsValor: {
		DisplayName: Asgard's Valor
		Tooltip:
			'''
			Allows the ability to ram dash
			The dash can slam through enemies without taking damage
			Increases maximum life by 50
			Grants immunity to knockback, lava and fire
			Grants immunity to most debuffs, including most forms of frost and flame
			Grants 12% damage reduction while submerged in liquid
			'''
	}

	OrnateShield: {
		DisplayName: Ornate Shield
		Tooltip:
			'''
			Allows a frost ram dash
			The dash slams through enemies without taking damage
			Increases life regeneration by 1 HP/s and maximum life by 20
			Grants 4 defense below 25% life
			'''
	}

	ShieldoftheOcean: {
		DisplayName: Shield of the Ocean
		Tooltip: Increases defense by 5 while submerged in liquid
	}

	Abaddon: {
		DisplayName: Abaddon
		Tooltip:
			'''
			Increases critical strike chance by 8%
			Projectile critical strikes create a brimstone explosion
			Grants immunity to Brimstone Flames
			'''
	}

	ElysianAegis: {
		DisplayName: Elysian Aegis
		Tooltip:
			'''
			Allows a holy-flame ram dash
			The dash slams through enemies without taking damage
			Increases maximum life by 30 and life regeneration by 1.5 HP/s
			Grants immunity to knockback, lava and fire
			Grants immunity to most fire debuffs, including Holy Flames and Daybreak
			Press [KEY] to toggle the guardian stance
			The stance drains shield charge into damage, critical strike chance, aggro and defense at the cost of movement speed
			'''
	}

	Affliction: {
		DisplayName: Affliction
		Tooltip:
			'''
			Gives you and all other players on your team powerful buffs and grants immunity to knockback
			Increases all damage by 15%
			Increases maximum life by 20%
			Increases defense by 45
			Increases damage reduction by 8%
			Increases life regeneration by 4 HP/s
			'''
	}

	AncientFossil: {
		DisplayName: Ancient Fossil
		Tooltip: Increases mining speed by 35% while underground or in the cavern layer
	}

	ArchaicPowder: {
		DisplayName: Archaic Powder
		Tooltip:
			'''
			Grants 3 defense and 7% damage reduction underground, in caverns, or in the Underworld
			Greatly increases mining speed in those layers
			'''
	}

	CorruptFlask: {
		DisplayName: Corrupt Flask
		Tooltip: Grants 3 defense and 7% damage reduction in the Corruption
	}

	CrimsonFlask: {
		DisplayName: Crimson Flask
		Tooltip: Grants 3 defense and 7% damage reduction in the Crimson
	}

	RadiantOoze: {
		DisplayName: Radiant Ooze
		Tooltip: Emits warm light and increases life regeneration at night
	}

	LivingDew: {
		DisplayName: Living Dew
		Tooltip: Increases life regeneration, defense, and damage reduction in the Jungle
	}

	HoneyDew: {
		DisplayName: Honey Dew
		Tooltip:
			'''
			Increases life regeneration, defense, and damage reduction in the Jungle
			Grants immunity to Poison and Venom and provides honey-like regeneration
			Most bee and hornet projectiles deal only 75% damage
			'''
	}

	AmbrosialAmpoule: {
		DisplayName: Ambrosial Ampoule
		Tooltip:
			'''
			Increases damage reduction by 12% and greatly increases mining speed
			Emits light and provides honey-like life regeneration
			Grants immunity to Poison, Venom, Frozen, Chilled, and both Frostburn debuffs
			Most bee and hornet projectiles deal only 75% damage
			'''
	}

	ManaJelly: {
		DisplayName: Mana Jelly
		Tooltip: Increases maximum mana by 20 and mana regeneration while standing still
	}

	LifeJelly: {
		DisplayName: Life Jelly
		Tooltip: Increases maximum life by 20 and life regeneration while standing still
	}

	VitalJelly: {
		DisplayName: Vital Jelly
		Tooltip: Increases movement speed by 10% and jump speed by 100%
	}

	GrandGelatin: {
		DisplayName: Grand Gelatin
		Tooltip:
			'''
			Increases movement speed by 10% and jump speed by 100%
			Increases maximum life and mana by 20
			Boosts life and mana regeneration while standing still
			'''
	}

	SeaShell: {
		DisplayName: Sea Shell
		Tooltip: Increases defense, damage reduction, and movement speed while submerged
	}

	CrawCarapace: {
		DisplayName: Craw Carapace
		Tooltip: Increases damage reduction by 5% and damages enemies on contact
	}

	FungalCarapace: {
		DisplayName: Fungal Carapace
		Tooltip: Releases a mushroom spore explosion when hit
	}

	GiantTortoiseShell: {
		DisplayName: Giant Tortoise Shell
		Tooltip: Reduces movement speed by 10% and damages enemies on contact
	}

	AmidiasSpark: {
		DisplayName: Amidias' Spark
		Tooltip: Releases a burst of sparks when damaged; stronger in Hardmode
	}

	GiantShell: {
		DisplayName: Giant Shell
		Tooltip: Reduces movement speed by 15% and grants a burst of speed when hit
	}

	TheAbsorber: {
		DisplayName: The Absorber
		Tooltip:
			'''
			Increases movement speed by 12% and jump speed by 120%
			Increases maximum life by 30 and maximum mana by 20
			Boosts life and mana regeneration while standing still
			Grants defense, damage reduction, movement speed, and water resistance while submerged
			Damages enemies on contact and grants a burst of speed when hit
			Releases sparks and truffle spores when hit
			Increases damage reduction by 6% and converts part of incoming damage into healing
			'''
	}

	Sponge: {
		DisplayName: Sponge
		Tooltip:
			'''
			Increases mining speed by 50% and emits light
			Increases damage reduction by 18% and life regeneration
			Grants immunity to Poison, Venom, Frozen, Chilled, and both Frostburn debuffs
			Provides honey-like regeneration without its movement penalty
			Most bee and hornet projectiles deal only 75% damage
			Increases movement speed by 12% and jump speed by 120%
			Increases maximum life and mana by 30 and boosts regeneration while standing still
			Grants defense, damage reduction, movement speed, and water resistance while submerged
			Damages enemies on contact and grants a burst of speed when hit
			Releases empowered sparks and truffle spores when hit
			Converts part of incoming damage into healing
			'''
	}
}

