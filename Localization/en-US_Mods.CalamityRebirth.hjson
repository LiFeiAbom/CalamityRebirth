Configs: {
	VanillaNerfRevertConfig: {
		DisplayName: Vanilla Nerf Reverts
		Headers.Gameplay: Gameplay

		RevertVanillaNerfs: {
			Label: Revert Calamity's Vanilla Nerfs
			Tooltip:
				'''
				Applies to CalamityMod 2.2.2, CalamityModClassicPreTrailer 1.4.2.101, and CalRD 1.4.5.7.
				Restores each version's reductions to vanilla weapons, tools, armor, accessories, wings, buffs, movement speed, and summon projectile damage.
				Nerfs to Calamity's own content are not changed.
				Requires a mod reload after changing.
				Default: Off.
				'''
		}
	}
}

